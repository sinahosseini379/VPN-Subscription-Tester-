# ─── GitHub (REQUIRED) ────────────────────────────────────────────────
# Create a Fine-grained PAT with "Contents: Read and write" on your target repo.
# NEVER commit config.env (it is gitignored); copy this file to config.env.
GITHUB_TOKEN=
GITHUB_OWNER=sinahosseini379
GITHUB_REPO=VPN-Subscription-Tester-
GITHUB_BRANCH=main

# Files uploaded to the repo after each run (relative to project dir).
GITHUB_FILES=best_configs.txt,best_configs.txt.meta.json

# ─── Pipeline ─────────────────────────────────────────────────────────
# CONFIGS_PER_COUNTRY=2   # best N configs per allowed country (in list order)
# SCHEDULE_TIME=04:04     # daily run time (HH:MM)
# TIMEZONE=Asia/Tehran    # IANA zone the schedule is evaluated in
# URL_TEST_ROUNDS=5       # URL-test rounds per config
# TCP_PING_TRIES=5        # TCP probe attempts
# TCP_PING_MIN_SUCCESS=4  # min successes to keep a config
# TCP_CONCURRENCY=100     # max parallel TCP probes (pre-filter)
# MAX_CONFIGS=500         # hard cap on configs entering the pipeline
# ALLOW_INSECURE=true     # tolerate self-signed/loose TLS (avoids false negatives)
# MAX_ERROR_RATE=0.15     # drop configs with weighted error rate above 15%
# MAX_CONCURRENT=10       # parallel Xray processes
# MAX_SUBSCRIPTION_URLS=10

# ─── Test targets (weighted) ────────────────────────────────────────────
# Format:  Label,URL[,weight]  separated by pipes. Higher weight = counts more
# in the final score. Example: YouTube,https://www.youtube.com/generate_204,2
# TEST_URLS=Google,http://www.gstatic.com/generate_204|YouTube,https://www.youtube.com/generate_204|Cloudflare,http://cp.cloudflare.com/|X.com,https://x.com/

# ─── Allowed exit countries (optional; empty = skip country filter) ───
# Format:  CODE:Display Name:Flag  separated by commas
# Order in this list = order in the output.
# ALLOWED_COUNTRIES=DE:Germany:🇩🇪,FI:Finland:🇫🇮,NL:Netherlands:🇳🇱,GB:United Kingdom:🇬🇧,US:United States:🇺🇸,TR:Turkey:🇹🇷

# ─── Managed cores (auto-download + auto-update) ──────────────────────
# Xray / sing-box / Hysteria2 are downloaded from their GitHub releases into
# CORES_DIR and re-checked for updates every run. Explicit paths always win.
# CORES_DIR=cores
# AUTO_UPDATE_CORES=true
# XRAY_BIN=/usr/local/bin/xray
# SING_BOX_BIN=
# HYSTERIA_BIN=
# XRAY_STARTUP_TIMEOUT=15

# ─── Incremental runs ──────────────────────────────────────────────────
# From the second run on, keep previous configs that still pass a fast test
# and only replace the dead ones.
# INCREMENTAL=true

# ─── Subscription profile ──────────────────────────────────────────────
# Name shown by client apps + auto-update interval advertised via /subscription.
# SUBSCRIPTION_NAME=Fiddel
# SUBSCRIPTION_INTERVAL_HOURS=24

# ─── Geo-IP providers (in order, first success wins) ──────────────────
# GEOIP_PROVIDERS=https://ipinfo.io/json,https://ip-api.com/json/,https://ipapi.co/json/

# ─── Alerting (optional) ──────────────────────────────────────────────
# Telegram: ALERT_WEBHOOK=https://api.telegram.org/bot<TOKEN>/sendMessage&chat_id=<ID>
# ntfy:     ALERT_WEBHOOK=https://ntfy.sh/<topic>
# ALERT_WEBHOOK=
# ALERT_MIN_CONFIGS=3

# ─── Dashboard (web UI) ────────────────────────────────────────────────
# DASHBOARD_ENABLED=true      # serve the dashboard next to the scheduler loop
# DASHBOARD_HOST=0.0.0.0      # bind address
# DASHBOARD_PORT=30445        # browser port

# ─── Incremental runs ───────────────────────────────────────────────────
# INCREMENTAL=true            # reuse working configs from previous run, only replace failed ones

# ─── Core management (auto-update Xray / Sing-box / Hysteria) ────────────
# AUTO_UPDATE_CORES=true       # auto-download and update cores
# CORES_DIR=cores              # directory to store cores
# XRAY_BIN=                    # explicit path (overrides auto-update)
# SING_BOX_BIN=                # explicit path (overrides auto-update)
# HYSTERIA_BIN=                # explicit path (overrides auto-update)

# ─── Subscription output ─────────────────────────────────────────────────
# SUBSCRIPTION_NAME=Fiddel     # subscription name shown in VPN apps
# SUBSCRIPTION_UPDATE_INTERVAL_HOURS=24  # auto-update interval for VPN apps

# ─── Output naming ───────────────────────────────────────────────────────
# OUTPUT_NAMING_FORMAT={country} | {num:02d}
