# ─── GitHub (REQUIRED) ────────────────────────────────────────────────
# Create a Fine-grained PAT with "Contents: Read and write" on your target repo.
# NEVER commit config.env (it is gitignored); copy this file to config.env.
GITHUB_TOKEN=
GITHUB_OWNER=sinahosseini379
GITHUB_REPO=VPN-Subscription-Tester-
GITHUB_BRANCH=main

# Files uploaded to the repo after each run (relative to project dir).
GITHUB_FILES=best_configs.txt,best_configs.txt.meta.json

# ─── Pipeline ─────────────────────────────────────────────────────────
# TOP_N=10                # keep best N configs
# URL_TEST_ROUNDS=5       # URL-test rounds per config
# TCP_PING_TRIES=5        # TCP probe attempts
# TCP_PING_MIN_SUCCESS=4  # min successes to keep a config
# MAX_ERROR_RATE=0.15     # drop configs with error rate above 15%
# LOOP_INTERVAL_MINUTES=90
# MAX_CONCURRENT=10       # parallel Xray processes
# MAX_SUBSCRIPTION_URLS=10

# ─── Allowed exit countries (optional; empty = skip country filter) ───
# Format:  CODE:Display Name:Flag  separated by commas
# ALLOWED_COUNTRIES=DE:Germany:🇩🇪,FI:Finland:🇫🇮,NL:Netherlands:🇳🇱,GB:United Kingdom:🇬🇧,US:United States:🇺🇸,CA:Canada:🇨🇦

# ─── Xray ─────────────────────────────────────────────────────────────
# Leave XRAY_BIN empty to auto-discover in PATH + common locations.
# XRAY_BIN=/usr/local/bin/xray
# XRAY_STARTUP_TIMEOUT=15

# ─── Geo-IP providers (in order, first success wins) ──────────────────
# GEOIP_PROVIDERS=https://ipinfo.io/json,https://ip-api.com/json/,https://ipapi.co/json/

# ─── Alerting (optional) ──────────────────────────────────────────────
# Telegram: ALERT_WEBHOOK=https://api.telegram.org/bot<TOKEN>/sendMessage&chat_id=<ID>
# ntfy:     ALERT_WEBHOOK=https://ntfy.sh/<topic>
# ALERT_WEBHOOK=
# ALERT_MIN_CONFIGS=3
